# 复制为仓库根目录 .env 后启动：
#   cp .env.docker.example .env
#   docker compose up --build -d

# ---------- 必填 ----------
OPENAI_API_KEY=your_zhipu_api_key_here
OPENAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
OPENAI_MODEL=glm-4.7
EMBEDDING_MODEL=embedding-3

# 视觉解析（可选；不设则回退 OPENAI_MODEL）
# OPENAI_VISION_MODEL=glm-4v-flash

# ---------- 鉴权 ----------
# 本地 Demo 可 true；公网务必 false 并设置强密钥
AUTH_DISABLED=false
AUTH_SECRET=change-me-in-production-use-at-least-32-chars
AUTH_TOKEN_EXPIRE_HOURS=72

# ---------- 运行 ----------
DEBUG=false
APP_NAME=AI Agent
# 一键镜像内 SERVE_FRONTEND=true（compose 已写入）；同域时 CORS 用 *
CORS_ORIGINS=*
APP_PORT=8000

# ---------- 持久化路径（与 compose 卷一致，一般无需改）----------
USERS_DB_PATH=/data/data/users.db
SESSIONS_DB_PATH=/data/data/sessions.db
CONVERSATIONS_DB_PATH=/data/data/conversations.db
EVAL_DB_PATH=/data/data/evaluations.db
RAG_STORE_PATH=/data/rag/store
MEMORY_STORE_PATH=/data/memory/store

# Session / Agent（可选）
# MAX_SESSION_TURNS=10
# SESSION_STORE_MAX_TURNS=100
# SESSION_SUMMARY_ENABLED=true
# MAX_AGENT_STEPS=10
