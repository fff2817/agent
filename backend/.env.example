# 智谱 AI - GLM-4.7
OPENAI_API_KEY=your_zhipu_api_key_here
OPENAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
OPENAI_MODEL=glm-4.7

# Embedding（RAG 向量化）
# OpenAI 官方: EMBEDDING_MODEL=text-embedding-3-small
# 智谱:        EMBEDDING_MODEL=embedding-3
EMBEDDING_MODEL=embedding-3

# 图片上传解析（视觉模型；不设则回退 OPENAI_MODEL）
# 智谱示例: OPENAI_VISION_MODEL=glm-4v-flash
# OPENAI_VISION_MODEL=

# 多用户鉴权（可选）
# AUTH_DISABLED=true
# AUTH_SECRET=change-me-in-production-use-at-least-32-chars
# AUTH_TOKEN_EXPIRE_HOURS=24
# USERS_DB_PATH=data/users.db
# SESSIONS_DB_PATH=data/sessions.db

# 其他可选模型：
# OPENAI_MODEL=glm-4.7-flash      # 更快、更省 token
# OPENAI_MODEL=glm-4.7-flashx     # 轻量高速版
