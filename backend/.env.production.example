# 复制为 .env.production 并填入真实值（不要提交 Git）
# 一键 Docker 请优先使用仓库根目录：.env.docker.example → .env

# LLM
OPENAI_API_KEY=your_zhipu_api_key
OPENAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
OPENAI_MODEL=glm-4.7
EMBEDDING_MODEL=embedding-3

# 公网 Demo 安全
AUTH_DISABLED=false
AUTH_SECRET=replace-with-at-least-32-char-random-string
AUTH_TOKEN_EXPIRE_HOURS=72

# 运行
DEBUG=false
APP_NAME=AI Agent Demo
CORS_ORIGINS=https://demo.example.com

# 持久化（Docker 卷挂载路径）
USERS_DB_PATH=/data/data/users.db
SESSIONS_DB_PATH=/data/data/sessions.db
CONVERSATIONS_DB_PATH=/data/data/conversations.db
EVAL_DB_PATH=/data/data/evaluations.db
RAG_STORE_PATH=/data/rag/store
MEMORY_STORE_PATH=/data/memory/store

# 单端口模式（根目录 Dockerfile / compose 默认 true）
SERVE_FRONTEND=false
