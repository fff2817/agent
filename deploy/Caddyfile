# 用法：将 demo.example.com 替换为你的域名，或改为 :80 做 HTTP Demo
demo.example.com {
	encode gzip

	# 前端静态文件
	root * /srv/frontend
	file_server
	try_files {path} /index.html

	# API + SSE
	handle /health {
		reverse_proxy backend:8000
	}
	handle /auth/* {
		reverse_proxy backend:8000
	}
	handle /chat* {
		reverse_proxy backend:8000 {
			flush_interval -1
			transport http {
				read_timeout 3600s
				write_timeout 3600s
			}
		}
	}
	handle /rag/* {
		reverse_proxy backend:8000 {
			flush_interval -1
			transport http {
				read_timeout 3600s
				write_timeout 3600s
			}
		}
	}
	handle /memory* {
		reverse_proxy backend:8000 {
			flush_interval -1
			transport http {
				read_timeout 3600s
				write_timeout 3600s
			}
		}
	}
	handle /documents* {
		reverse_proxy backend:8000 {
			transport http {
				read_timeout 300s
				write_timeout 300s
			}
		}
	}
	handle /docs* {
		reverse_proxy backend:8000
	}
	handle /openapi.json {
		reverse_proxy backend:8000
	}
	handle /redoc {
		reverse_proxy backend:8000
	}
}
