# 本地 HTTP Demo（无域名）或替换为你的域名
:80 {
	encode gzip

	# 全部反代到 app（前后端同容器时最简单）
	handle {
		reverse_proxy app:8000 {
			flush_interval -1
			transport http {
				read_timeout 3600s
				write_timeout 3600s
			}
		}
	}
}

# 生产示例（按域名拆分静态与 API 时可启用并注释上面的 :80）
